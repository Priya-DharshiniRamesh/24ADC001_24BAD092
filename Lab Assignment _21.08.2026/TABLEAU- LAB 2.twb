              <calculation class='tableau' formula='CASE [day_of_week]&#13;&#10;WHEN &quot;Monday&quot; THEN 1&#13;&#10;WHEN &quot;Tuesday&quot; THEN 2&#13;&#10;WHEN &quot;Wednesday&quot; THEN 3&#13;&#10;WHEN &quot;Thursday&quot; THEN 4&#13;&#10;WHEN &quot;Friday&quot; THEN 5&#13;&#10;WHEN &quot;Saturday&quot; THEN 6&#13;&#10;WHEN &quot;Sunday&quot; THEN 7&#13;&#10;END' />
            </column>
