      </column>
      <column caption='New Deaths (Clean)' datatype='real' name='[Calculation_2239457315123202]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([new_deaths])' />
      </column>
      <column caption='Total Deaths (Clean)' datatype='real' name='[Calculation_2239457315250179]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ZN([total_deaths])' />
      </column>
      <column caption='People Vaccinated (Clean)' datatype='integer' datatype-customized='true' name='[Calculation_2239457315373060]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='INT(ZN([people_vaccinated]))' />
      </column>
      <column caption='Case Fatality Rate' datatype='real' default-format='p0.00%' name='[Calculation_2239457317883909]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([total_deaths]) / SUM([total_cases])' />
      </column>
      <column caption='Vaccination Coverage' datatype='real' default-format='p0.00%' name='[Calculation_2239457318567942]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([people_vaccinated]) / SUM([population])' />
      </column>
      <column caption='Daily Case Growth Rate' datatype='real' default-format='p0.00%' name='[Calculation_2239457318670343]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([total_cases]) = 0 THEN&#13;&#10;0&#13;&#10;ELSE&#13;&#10;SUM([Calculation_2239457314762753]) / SUM([total_cases]) * 100&#13;&#10;END' />
      </column>
      <column caption='Latest Total Cases' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_2239457386844168]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [location] :&#13;&#10;    MAX(&#13;&#10;        IF [date] = { FIXED [location] : MAX([date]) }&#13;&#10;        THEN [total_cases]&#13;&#10;        END&#13;&#10;    )&#13;&#10;}' />
      </column>
      <column caption='Latest Total Deaths' datatype='real' default-format='n#,##0,,.0M;-#,##0,,.0M' name='[Calculation_2239457387069449]' role='measure' type='quantitative'>
