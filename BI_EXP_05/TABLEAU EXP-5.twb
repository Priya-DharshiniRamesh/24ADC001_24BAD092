      <column caption='Profit Margin %' datatype='real' default-format='p0.00%' name='[Calculation_0795798922743808]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Sales Growth %' datatype='real' default-format='p0.00%' name='[Calculation_0795798922948609]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -1))&#13;&#10;/&#13;&#10;ABS(LOOKUP(SUM([Sales]), -1))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='YTD Sales' datatype='real' name='[Calculation_0795798923063298]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Sales]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Selected KPI' datatype='real' name='[Calculation_0795798939860995]' role='measure' type='quantitative'>
